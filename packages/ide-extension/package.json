{
  "name": "tla-terraform-extension",
  "displayName": "TLA Terraform Translation",
  "version": "0.1.0",
  "publisher": "tla-platform",
  "categories": ["Other"],
  "engines": { "vscode": "^1.85.0" },
  "activationEvents": ["onLanguage:terraform"],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --watch",
    "package": "vsce package --no-dependencies",
    "test": "vitest run"
  },
  "contributes": {
    "configuration": {
      "title": "TLA Translation",
      "properties": {
        "tla.targetProvider": { "type": "string", "default": "both", "enum": ["azure", "gcp", "both"] },
        "tla.enableDiagnostics": { "type": "boolean", "default": true }
      }
    }
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "~5.8.3",
    "vitest": "^3.1.1"
  }
}
